# PROPWASH environment variables — copy to .env and fill in values

# Required: Anthropic API key for Claude agents (Tier 3)
ANTHROPIC_API_KEY=sk-ant-...

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://propwash:propwash@localhost/propwash

# Redis (job queue + live state)
REDIS_URL=redis://localhost:6379/0

# Feature flags — see CLAUDE.md §7
# Path B: Lucid vendor API (UNVERIFIED — do not enable without confirmation)
PROPWASH_ENABLE_PATH_B=false

# Path C: companion computer (requires Lucid cooperation + FAA waiver)
PROPWASH_ENABLE_PATH_C=false

# App
PROPWASH_ENV=development
LOG_LEVEL=INFO
