# PROPWASH operator mobile app — copy to .env (Expo auto-loads EXPO_PUBLIC_* into the bundle).
#
# Point these at the PROPWASH FastAPI backend. On a physical field device these
# must be the LAN/tunnel address of the ground station, NOT localhost.

# REST base URL (see frontend/src/api.js for the matching web contract)
EXPO_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL for /jobs/ws/telemetry
EXPO_PUBLIC_WS_URL=ws://localhost:8000
